# Copy to .env (git-ignored) and fill in.

# Postgres connection for the existing secret_mgmt_leap database.
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/secret_mgmt_leap

# Encrypts every stored env file. Generate once and keep it safe; losing it makes stored files unreadable.
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
VAULT_MASTER_KEY=

# Optional: if set, creating a new team in the UI requires this value.
ADMIN_TOKEN=

# Optional: set to true when served over HTTPS.
SESSION_COOKIE_SECURE=false
